# PULSE Environment Configuration
# Copy this file to .env and fill in the values

# MongoDB
MONGODB_URI=mongodb://localhost:27017/pulse
MONGO_URI=mongodb://127.0.0.1:27017/pulse

# Server
PORT=5000
NODE_ENV=development

# Razorpay (optional - falls back to mock mode if not set)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Demo Mode (set to true for demo/hackathon)
DEMO_MODE=true
MERCHANT_ID=MERCHANT_TRENDCART_001
